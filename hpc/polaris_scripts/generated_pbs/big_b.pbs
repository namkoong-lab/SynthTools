#!/bin/bash
#PBS -A CausalAlign
#PBS -q prod
#PBS -l select=50:system=polaris
#PBS -l walltime=06:00:00
#PBS -l filesystems=home:eagle
#PBS -N tg_big_b
#PBS -o /lus/eagle/projects/CausalAlign/tommicaste/tool_content/_pbs_logs/big_b.out
#PBS -e /lus/eagle/projects/CausalAlign/tommicaste/tool_content/_pbs_logs/big_b.err

# Auto-generated by submit_pending_batches.sh.
# Big job for half 'b' — 50 nodes for 06:00:00.
# On start: qdel tg_b<NN> jobs in this half (one-shot), then process up to
# 50 pending fields. The runner self-skips trajectories already on disk,
# so any concurrent overlap with a not-yet-qdel'd preemptable batch is safe.

set -uo pipefail

echo "[big_b] qdel-ing tg_b<NN> jobs in half 'b'..."
ids=$(python3 /home/tommicaste/projects/burn-gpu/polaris_scripts/lib/batch_status.py batch-jobids b 2>/dev/null || true)
if [[ -n "$ids" ]]; then
  echo "  ids: $(echo $ids | tr '\n' ' ')"
  echo "$ids" | xargs -r qdel || true
  sleep 5
else
  echo "  (none in flight)"
fi

mapfile -t pending < <(python3 /home/tommicaste/projects/burn-gpu/polaris_scripts/lib/batch_status.py pending-fields b 50)
if (( ${#pending[@]} == 0 )); then
  echo "[big_b] no pending fields at run time — exiting cleanly"
  exit 0
fi

export FIELDS=$(printf '%s\n' "${pending[@]}")
echo "[big_b] running ${#pending[@]} pending fields (allocation: 50 nodes)"
bash /home/tommicaste/projects/burn-gpu/polaris_scripts/run_traj_gen_field_per_node.sh
