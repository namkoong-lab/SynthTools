# Example .env for Polaris (ALCF) HPC runs.
#
# Copy to `~/projects/SynthTools/.env` (NOT checked in — see top-level
# .gitignore) and set the values that apply to your account. The Polaris
# launcher scripts under `hpc/polaris_scripts/` source this file (when it
# exists) so the same scripts work on different users' setups without edits.

# --- Hugging Face cache + auth ---
# Cache root for model downloads. Point at fast filesystem; HF will reuse
# anything already present.
HF_HOME=/lus/eagle/projects/CausalAlign/${USER}/.cache/huggingface

# Required for gated models (e.g. Llama family). Generate at
# https://huggingface.co/settings/tokens.
HF_TOKEN=

# --- Scratch / data ---
# Root of all generated artefacts (env_specs, tasks, eval logs, …).
TOOL_CONTENT=/lus/eagle/projects/CausalAlign/${USER}/tool_content

# --- Virtual env ---
# Path to the venv activation script (vLLM, openai, pyyaml, etc. installed).
VENV=/lus/eagle/projects/CausalAlign/${USER}/envs/synthtools/bin/activate

# --- Repo root (override only if not the conventional path) ---
# REPO=${HOME}/projects/SynthTools
